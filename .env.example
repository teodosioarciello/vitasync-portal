# Ambiente
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database
DATABASE_URL=postgresql+psycopg://vitasync:vitasync_dev_password@postgres:5432/vitasync

# Redis
REDIS_URL=redis://redis:6379/0

# CORS / Frontend
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Session cookie
SESSION_COOKIE_NAME=vitasync_session
SESSION_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Email verification
EMAIL_VERIFICATION_REQUIRED=true
DEV_AUTO_VERIFY_EMAIL=true
DEV_EXPOSE_VERIFICATION_LINK=true

# SMTP opzionale. Per ora stub nei log.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@vitasync.local

# MinIO / object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_password
MINIO_BUCKET=vitasync-documents
MINIO_SECURE=false

# Upload documenti
MAX_UPLOAD_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/heic

# AI cloud: disabilitata nello scaffold iniziale
AI_ENABLED=false

# Registrazione
# In beta familiare consiglio: REQUIRE_INVITE_CODE=true
REGISTRATION_MODE=open
REQUIRE_INVITE_CODE=false
INVITE_CODE=