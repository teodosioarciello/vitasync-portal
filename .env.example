ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

DATABASE_URL=postgresql+psycopg://vitasync:vitasync_dev_password@postgres:5432/vitasync
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

SESSION_COOKIE_NAME=vitasync_session
SESSION_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

EMAIL_VERIFICATION_REQUIRED=true
DEV_AUTO_VERIFY_EMAIL=true
DEV_EXPOSE_VERIFICATION_LINK=true

SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@vitasync.local

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/documents

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_password
MINIO_BUCKET=vitasync-documents
MINIO_SECURE=false

MAX_UPLOAD_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/heic

AI_ENABLED=false

# --- OCR backend (Sprint OCR) ---
# tesseract = solo Tesseract (default); ollama = VLM via Ollama; hybrid = VLM con fallback Tesseract
# Su Raspberry Pi 5 senza GPU consigliato: OLLAMA + qwen2.5vl:3b (~4GB RAM) oppure minicpm-v
OCR_BACKEND=tesseract
OCR_OLLAMA_BASE_URL=http://ollama:11434
OCR_OLLAMA_MODEL=qwen2.5vl:3b
OCR_OLLAMA_TIMEOUT_SECONDS=300
OCR_FALLBACK_TO_TESSERACT=true

# --- Estrazione valori esami con SLM locale (Sprint 6.3) ---
# L'AI (Ollama residente in locale, mai internet) legge il referto e restituisce
# solo i veri esami in JSON, scartando indirizzi/footer/firme. Se disabilitata o
# in caso di errore si usa il parser euristico classico.
LAB_EXTRACT_ENABLED=false
LAB_EXTRACT_MODEL=            # vuoto = usa OCR_OLLAMA_MODEL (es. qwen2.5vl:3b)
LAB_EXTRACT_MIN_ITEMS=2       # sotto questa soglia di item vince il parser classico

REGISTRATION_MODE=open
REQUIRE_INVITE_CODE=false
INVITE_CODE=
