# VitaSync Portal - Configurazione Produzione (Hardened)
# Copia in .env.production e personalizza prima del deploy remoto.

ENVIRONMENT=production
SECRET_KEY=change-me-in-production-with-strong-random-string

DATABASE_URL=postgresql+psycopg://vitasync_user:STRONG_PASSWORD_HERE@postgres:5432/vitasync
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=https://vitasync.tuodominio.com
FRONTEND_URL=https://vitasync.tuodominio.com

SESSION_COOKIE_NAME=vitasync_session
SESSION_EXPIRE_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

EMAIL_VERIFICATION_REQUIRED=true
DEV_AUTO_VERIFY_EMAIL=false
DEV_EXPOSE_VERIFICATION_LINK=false

SMTP_HOST=smtp.tuoserver.com
SMTP_PORT=587
SMTP_USERNAME=utente@tuoserver.com
SMTP_PASSWORD=password-app-dedicata
SMTP_FROM=noreply@vitasync.tuodominio.com
SMTP_ENCRYPTION_KEY=chiave-fernet-forte-min-32-caratteri

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/documents
MAX_UPLOAD_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/heic

AI_ENABLED=false

REGISTRATION_MODE=invite_only
REQUIRE_INVITE_CODE=true
INVITE_CODE=genera-un-codice-forte-min-16-caratteri